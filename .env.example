# ----------------------------------------------------------------------------
# Keystone environment — copy to `.env` and fill in real values.
# NEVER commit `.env`; this file only documents the variables the app reads.
# ----------------------------------------------------------------------------

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection (pooled endpoint, e.g. Neon with pgbouncer).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Direct (non-pooled) endpoint for `prisma migrate`. On Neon copy the
# "Direct connection" URL; omit to fall back to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth secret for Better Auth. Required in production — the server refuses to
# boot without it. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"

# Public origin of the app (used for auth callbacks/cookies).
BETTER_AUTH_URL="http://localhost:3000"

# Bearer token required by /api/apply/* endpoints (job-application agent).
# Generate with: openssl rand -hex 32
APPLY_AGENT_TOKEN="replace-me"

# ── Optional ────────────────────────────────────────────────────────────────

# Google OAuth. Leave unset to hide the "Continue with Google" buttons.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenCode server basic-auth password. If unset, one is generated at boot and
# passed to the spawned server automatically (single-container deployment).
OPENCODE_SERVER_PASSWORD=""

# Database resilience tuning (defaults are sensible; set only if needed).
# DB_READ_TIMEOUT_MS="10000"
# DB_RETRY_ATTEMPTS="3"
# DB_RETRY_BASE_MS="300"
# DB_RETRY_MAX_MS="2000"
