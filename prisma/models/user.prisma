model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  resumes   Resume?
  jobs      JobListing[]
  search    SearchSession[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String   @unique
  fileName  String
  filePath  String
  content   String?
  parsedAt  DateTime?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
}
