enum JobListingStatus {
  OPEN
  APPLIED
  INTERVIEW
  OFFER          // Recieved an offer
  REJECTED
  DECLINED
}

model JobListing {
  id          String   @id @default(cuid())
  userId      String
  title       String
  company     String
  location    String?
  url         String?
  description String?
  salary      String?
  type        String
  country     String?
  status      JobStatus @default(OPEN)
  source      String?
  notes       String?
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id])
}
