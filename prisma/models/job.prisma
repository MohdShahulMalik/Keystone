enum JobListingStatus {
  OPEN
  APPLIED
  INTERVIEW
  OFFER // Recieved an offer
  REJECTED
  DECLINED
}

model JobListing {
  id          String           @id @default(cuid())
  userId      String
  title       String
  company     String
  location    String
  url         String?
  description String
  salary      String?
  experience  String
  visa        String?
  type        String
  country     String?
  status      JobListingStatus @default(OPEN)
  notes       String?
  appliedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  statusChanges JobStatusChange[]

  user User @relation(fields: [userId], references: [id])
}

model JobStatusChange {
  id        String           @id @default(cuid())
  listingId String
  toStatus  JobListingStatus
  createdAt DateTime         @default(now())

  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([createdAt])
}
